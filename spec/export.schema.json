{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.arianw.de/shrippen/Kaiwa/spec/export.schema.json",
  "title": "Kaiwa profile export (kaiwa-export/4)",
  "description": "Everything Kaiwa keeps about one profile (Lastenheft /LF710/, /LD010/-/LD060/). Audio is never part of it.",
  "type": "object",
  "required": ["schema", "exported_at", "profile", "learning", "sessions", "items", "days", "pauses", "disputes", "costs", "events"],
  "additionalProperties": false,
  "$defs": {
    "moment": {
      "type": "object",
      "required": ["unix", "offset_min"],
      "properties": { "unix": { "type": "integer" }, "offset_min": { "type": "integer" } },
      "additionalProperties": false
    },
    "day": { "type": "integer", "description": "Local days since 1970-01-01." }
  },
  "properties": {
    "schema": { "const": "kaiwa-export/4" },
    "exported_at": { "$ref": "#/$defs/moment" },
    "profile": {
      "type": "object",
      "required": ["name", "ui_lang", "daily_goal", "gamification", "feedback", "feedback_source", "script", "end_pause_secs", "keep_recordings_days", "style", "placed", "reminder"],
      "properties": {
        "ui_lang": { "enum": ["de", "en"] },
        "feedback": { "enum": ["little", "normal", "much"] },
        "feedback_source": { "enum": ["default", "level", "chosen"] },
        "script": { "enum": ["furigana", "kana", "hidden"] },
        "gamification": { "type": "boolean" },
        "keep_recordings_days": { "type": ["integer", "null"], "minimum": 1 },
        "cost_limit_cents": { "type": ["integer", "null"], "minimum": 0 },
        "mora_hints": { "type": "boolean" },
        "louder": { "type": "boolean" },
        "clear": { "type": "boolean" },
        "unload_after_min": { "type": ["integer", "null"], "minimum": 1 },
        "hands_free": { "type": "boolean" },
        "text_scale": { "type": "number", "minimum": 1, "maximum": 2 }
      }
    },
    "learning": {
      "type": "object",
      "required": ["model", "regulator", "course"],
      "properties": {
        "model": { "type": "object", "required": ["skills"] },
        "regulator": { "type": "object", "required": ["difficulty", "success", "changes"] },
        "course": { "type": "object", "required": ["scenarios_done", "skipped_units"] }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row", "state"],
        "properties": {
          "row": {
            "type": "object",
            "required": ["id", "scenario", "started", "finished", "xp", "speaking_secs"],
            "properties": {
              "id": { "type": "string", "description": "The id of the talk's start event, `<device>-<number>`; `old-<n>` for a talk from before the journal." },
              "started": { "$ref": "#/$defs/moment" },
              "finished": { "type": "boolean" }
            }
          },
          "state": { "type": "object", "required": ["scenario", "messages", "turns", "goals_met"] }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "kind", "source", "added", "due", "reps", "lapses"],
        "properties": { "kind": { "enum": ["word", "phrase", "pattern"] }, "due": { "$ref": "#/$defs/day" } }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "n", "record"],
        "properties": { "day": { "type": "string", "format": "date" }, "n": { "$ref": "#/$defs/day" } }
      }
    },
    "pauses": { "type": "array", "items": { "type": "object", "required": ["from", "to"] } },
    "costs": {
      "type": "object",
      "description": "The estimated cost of each month (/LF714/), by \"YYYY-MM\".",
      "propertyNames": { "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
      "additionalProperties": {
        "type": "object",
        "required": ["cents", "calls", "unknown_calls", "sessions"],
        "properties": {
          "cents": { "type": "number", "minimum": 0 },
          "calls": { "type": "integer", "minimum": 0 },
          "unknown_calls": { "type": "integer", "minimum": 0 },
          "sessions": { "type": "integer", "minimum": 0 },
          "paid": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "The journal (ADR-010) in fold order: its start (`base`, the state when the profile began to sync, as this export without `events`) first, then time, then device, then number.",
      "items": {
        "type": "object",
        "required": ["id", "device", "seq", "at", "offset_min", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "`<device>-<seq>`." },
          "device": { "type": "string" },
          "seq": { "type": "integer", "minimum": 1 },
          "at": { "type": "integer", "description": "Unix seconds." },
          "offset_min": { "type": "integer", "description": "Local time zone offset at that moment, minutes." },
          "body": {
            "type": "object",
            "description": "What the learner did; `kind` names it.",
            "required": ["kind"],
            "properties": { "kind": { "enum": ["base", "review", "setting", "talk_begun", "talk_saved", "talk_finished", "talk_corrected", "placed", "placement_left_out", "nudged", "skipped", "word_added", "paused", "pause_ended", "disputed", "costs_booked", "break_spread"] } }
          }
        }
      }
    },
    "disputes": {
      "type": "array",
      "items": { "type": "object", "required": ["at", "scenario", "learner", "original", "better", "explanation"] }
    }
  }
}
