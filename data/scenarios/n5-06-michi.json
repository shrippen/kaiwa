      "help": {
        "keyword": "遠い（とおい）",
        "start": "ここから…",
        "example": "ここから遠いですか。"
      }
    },
    {
      "id": "thanks",
      "text": {
        "de": "Bedank dich.",
        "en": "Say thank you."
      },
      "help": {
        "keyword": "ありがとうございます",
