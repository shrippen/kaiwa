# Kaiwa from the Git main branch (/LL500/). kaiwad and the plasmoid join before 1.0 (M4);
# the plasmoid then comes with this package, not from the KDE Store (F-11).
pkgname=kaiwa-git
pkgver=0.4.0
pkgrel=1
pkgdesc="Japanese conversation trainer for KDE Plasma"
arch=(x86_64)
url="https://git.arianw.de/shrippen/Kaiwa"
license=(MIT)
depends=(qt6-base qt6-declarative qt6-svg kirigami alsa-lib)
optdepends=('kwallet: keep API keys of a cloud tutor (or another Secret Service)')
makedepends=(git rust qt6-shadertools pkgconf)
provides=(kaiwa)
conflicts=(kaiwa)
source=("kaiwa::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd kaiwa
  printf "0.4.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd kaiwa
  export QMAKE=/usr/bin/qmake6
  cargo build --release --locked -p kaiwa-app
}

package() {
  cd kaiwa
  install -Dm755 target/release/kaiwa "$pkgdir/usr/bin/kaiwa"
  install -Dm644 packaging/org.shrippen.kaiwa.desktop "$pkgdir/usr/share/applications/org.shrippen.kaiwa.desktop"
  install -Dm644 packaging/org.shrippen.kaiwa.metainfo.xml "$pkgdir/usr/share/metainfo/org.shrippen.kaiwa.metainfo.xml"
  install -Dm644 icons/kaiwa.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.shrippen.kaiwa.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
